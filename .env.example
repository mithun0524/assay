# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env* is gitignored.
#
#   supabase link --project-ref <ref>
#   supabase projects api-keys --project-ref <ref>
# ─────────────────────────────────────────────────────────────

# Supabase — https://supabase.com (free tier: 50k MAU, 500MB db, 1GB storage)
# Project Settings → API. Both of these are safe in the browser by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — that ships it to the browser
# and hands every visitor full database access. Required for:
#   - storing the GitHub provider token after OAuth (/api/auth/callback)
#   - reading a shared project by id (/api/share), since the table is not
#     readable by anon
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — https://openrouter.ai (the three :free models need no billing)
# Set this and every user shares your quota. Leave empty to make each user
# supply their own key in Settings instead.
OPENROUTER_API_KEY=

# Public origin. Used for OAuth redirects and share links; must match one of
# the Redirect URLs configured in Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tavily — https://tavily.com. Optional: without it the agents cannot search
# the web, and the search action degrades to a warning in the console.
TAVILY_API_KEY=
